---
import { withBase } from '../utils/base'
import type { Locale } from '../utils/i18n'

interface Props {
  lang: Locale
  currentPath: string
}

const { lang, currentPath } = Astro.props

const locales: Array<{ code: string; label: string }> = [
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
  { code: 'lb', label: 'LB' },
]

// Strip the deployment sub-path (GitHub Pages project site) before matching.
const base = import.meta.env.BASE_URL || '/'
const basePrefix = base === '/' ? '' : base.replace(/\/$/, '')
const rel = basePrefix && currentPath.startsWith(basePrefix)
  ? currentPath.slice(basePrefix.length) || '/'
  : currentPath

function toLocaleLink(code: string): string {
  const blog = /^\/blog\/(?:en|fr|lb)(\/.*)?$/.exec(rel)
  if (blog) {
    return withBase(`/blog/${code}${blog[1] ?? ''}`)
  }

  const section = /^\/(about|experience|projects|resume)\//.exec(rel)
  if (section) {
    return withBase(`/${section[1]}/${code}/`)
  }

  return withBase(code === 'en' ? '/' : `/${code}/`)
}
---

<div class="flex items-center gap-1 rounded-full border border-hairline bg-surface px-1.5 py-1">
  {
    locales.map((locale) => (
      <a
        href={toLocaleLink(locale.code)}
        class:list={[
          'inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-mono text-xs font-semibold no-underline transition-colors hover:text-fg',
          lang === locale.code
            ? 'bg-accent-soft text-accent'
            : 'text-muted',
        ]}
        aria-label={locale.label}
        title={locale.label}
      >
        <svg
          viewBox="0 0 24 16"
          class="h-3.5 w-5 rounded-[2px] shadow-[0_0_0_1px_rgba(128,128,128,0.4)]"
          aria-hidden="true"
        >
          {locale.code === 'en' ? (
            <>
              <rect width="24" height="16" fill="#012169" />
              <g stroke-linecap="round">
                <path d="M0,0 L24,16 M24,0 L0,16" stroke="#fff" stroke-width="3" />
                <path d="M0,0 L24,16 M24,0 L0,16" stroke="#C8102E" stroke-width="1.6" />
                <path d="M12,0 L12,16 M0,8 L24,8" stroke="#fff" stroke-width="4.4" />
                <path d="M12,0 L12,16 M0,8 L24,8" stroke="#C8102E" stroke-width="2.6" />
              </g>
            </>
          ) : locale.code === 'fr' ? (
            <>
              <rect width="8" height="16" fill="#0055A4" />
              <rect x="8" width="8" height="16" fill="#FFFFFF" />
              <rect x="16" width="8" height="16" fill="#EF4135" />
            </>
          ) : (
            <>
              <rect width="24" height="5.333" fill="#EF3340" />
              <rect y="5.333" width="24" height="5.333" fill="#FFFFFF" />
              <rect y="10.666" width="24" height="5.334" fill="#00A3E0" />
            </>
          )}
        </svg>
        <span>{locale.label}</span>
      </a>
    ))
  }
</div>
