---
import { bodyTranslations, posts as postMetas } from '../data'
import { rich } from '../data/rich'
import { getDict, normalizeLang } from '../utils/i18n'
import { readingTime } from '../utils/markdown'
import { withBase } from '../utils/base'
import UiPill from './UiPill.astro'

interface Props {
  lang: string
}

const { lang: langProp } = Astro.props
const blogLang = normalizeLang(langProp)
const dict = getDict(blogLang)

function formatDate(date: string): string {
  if (!date) return ''
  const parsed = new Date(date)
  if (Number.isNaN(parsed.getTime())) return date
  return parsed.toLocaleDateString(blogLang === 'lb' ? 'lb-LU' : blogLang, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}

const prefix = withBase(`/blog/${blogLang}/`)
const posts = postMetas
  .map((meta) => ({
    slug: meta.slug,
    title: meta.title[blogLang] ?? meta.slug,
    date: meta.date,
    description: meta.description[blogLang] ?? '',
    tags: meta.tags,
    readingTime: readingTime(
      Object.values(bodyTranslations[meta.slug] ?? {})
        .map((t) => t.en ?? '')
        .join('\n'),
    ),
    url: `${prefix}${meta.slug}/`,
  }))
  .sort((a, b) => b.date.localeCompare(a.date))
---

<div>
  <h1 set:html={rich(dict.blog.heading)} />
  <p class="mt-1 text-gray-600 dark:text-gray-400">{dict.blog.subtitle}</p>
  <div class="mt-6 flex flex-col gap-4">
    {
      posts.map((post) => (
        <a
          href={post.url}
          class="group post-item block rounded-xl border border-brand-500/15 bg-surface p-5 shadow-sm dark:border-brand-400/20 dark:bg-brand-950/50"
        >
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <time>{formatDate(post.date)}</time>
            <span>
              {' '}
              · {post.readingTime} {dict.blog.minutes}
            </span>
          </div>
          <h2 class="post-title text-xl font-semibold text-brand-600 group-hover:underline dark:text-brand-400">
            {post.title}
          </h2>
          <p class="mt-1 text-gray-600 dark:text-gray-300">{post.description}</p>
          {post.tags.length > 0 && (
            <p class="mt-2 flex flex-wrap gap-1.5">
              {post.tags.map((tag) => (
                <UiPill size="sm">{tag}</UiPill>
              ))}
            </p>
          )}
          <span class="mt-3 inline-block text-sm font-semibold text-brand-600 dark:text-brand-400">
            {dict.blog.readMore} →
          </span>
        </a>
      ))
    }
  </div>
</div>
