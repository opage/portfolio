---
import '../../themes/purple/styles.css'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { withBase } from '../utils/base'
import { normalizeLang, type Locale } from '../utils/i18n'
import { footer as footerTexts, nav as navItems, siteDescription, siteName } from '../utils/site'

interface Props {
  title?: string
  description?: string
  lang?: string
  currentPath?: string
}

const {
  title,
  description,
  lang: langProp,
  currentPath: currentPathProp,
} = Astro.props

const lang: Locale = normalizeLang(langProp)
const currentPath = currentPathProp ?? Astro.url.pathname
const pageTitle = title && title.length > 0 ? title : siteName
const fullTitle = pageTitle === siteName ? siteName : `${pageTitle} | ${siteName}`
const pageDescription = description ?? siteDescription[lang]

const base = import.meta.env.BASE_URL || '/'
const basePrefix = base === '/' ? '' : base.replace(/\/$/, '')
const rel =
  basePrefix && currentPath.startsWith(basePrefix)
    ? currentPath.slice(basePrefix.length) || '/'
    : currentPath

const normalize = (p: string) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p)
const current = normalize(rel === '' ? '/' : rel)
const isActive = (link: string) =>
  link === '/' ? current === '/' || current === '/fr' || current === '/lb' : current === normalize(link)

const csp =
  "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/images/favicon.ico')} />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Inter:wght@100..900&family=JetBrains+Mono:wght@100..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var stored = localStorage.getItem('theme')
        var theme = stored === 'dark' || stored === 'light'
          ? stored
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
        document.documentElement.setAttribute('data-theme', theme)
      } catch (e) {
        /* appearance defaults to light when storage is unavailable */
      }
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav sticky top-0 z-50">
      <div class="mx-auto flex w-full max-w-6xl items-center gap-5 px-6 py-5">
        <a
          href={withBase(lang === 'en' ? '/' : `/${lang}/`)}
          class="font-display text-xl no-underline"
          style="font-variation-settings: 'opsz' 36, 'wght' 510; letter-spacing: -0.02em;"
          aria-label={siteName}
        >
          {siteName}<span class="text-accent">.</span>
        </a>
        <nav class="ml-3.5 hidden items-center gap-[22px] md:flex" aria-label="Main navigation">
          {
            navItems[lang].map((item) => (
              <a
                href={withBase(item.link)}
                aria-current={isActive(item.link) ? 'page' : undefined}
                class="masthead-link"
              >
                {item.text}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-2.5">
          <LanguageSwitcher lang={lang} currentPath={currentPath} />
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg
              class="theme-toggle__icon theme-toggle__icon--moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6.4 6.4 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <svg
              class="theme-toggle__icon theme-toggle__icon--sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="12" y1="2" x2="12" y2="4"></line>
              <line x1="12" y1="20" x2="12" y2="22"></line>
              <line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line>
              <line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line>
              <line x1="2" y1="12" x2="4" y2="12"></line>
              <line x1="20" y1="12" x2="22" y2="12"></line>
              <line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line>
              <line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line>
            </svg>
          </button>
          <button
            id="menu-toggle"
            type="button"
            class="theme-toggle md:hidden"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
          >
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="17" y2="6"></line>
              <line x1="3" y1="10" x2="17" y2="10"></line>
              <line x1="3" y1="14" x2="17" y2="14"></line>
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" class="mx-auto hidden w-full max-w-6xl px-6 pb-4 md:hidden" aria-label="Mobile navigation">
        <div class="rounded-lg border border-hairline bg-bg p-3 shadow-lg">
          {
            navItems[lang].map((item) => (
              <a
                href={withBase(item.link)}
                aria-current={isActive(item.link) ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-2 py-2 text-[15px] font-medium no-underline',
                  isActive(item.link) ? 'text-fg' : 'text-muted',
                ]}
              >
                {item.text}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-6xl px-6 py-8">
      <slot />
    </main>

    <footer class="mt-8 border-t border-hairline py-8 text-center text-sm text-muted">
      <p>{footerTexts[lang].message}</p>
      <p class="mt-1">{footerTexts[lang].copyright}</p>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement
        var toggle = document.getElementById('theme-toggle')
        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
            root.setAttribute('data-theme', next)
            try {
              localStorage.setItem('theme', next)
            } catch (e) {
              /* ignore storage errors */
            }
          })
        }
        var menuButton = document.getElementById('menu-toggle')
        var menu = document.getElementById('mobile-menu')
        if (menuButton && menu) {
          menuButton.addEventListener('click', function () {
            var open = menu.classList.toggle('hidden') === false
            menuButton.setAttribute('aria-expanded', open ? 'true' : 'false')
          })
        }
      })()
    </script>
  </body>
</html>

<style>
  .site-nav {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--hairline);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    transition: all 160ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .theme-toggle:hover {
    background: var(--fill-subtle);
    color: var(--fg);
  }
  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--accent-ring);
    color: var(--fg);
  }

  /* Unlayered .theme-toggle display wins over Tailwind's layered md:hidden,
     so hide the mobile-only menu button explicitly on wide layouts. */
  @media (min-width: 768px) {
    #menu-toggle {
      display: none;
    }
  }
</style>
